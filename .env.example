# TEMPLATE ONLY. Do not commit real secrets to GitHub.
# On Render, enter these as Environment Variables instead.
# Replace all example values with credentials from your chosen providers.

PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/EMAILDB
DATABASE_SSL=true

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=replace-with-your-smtp-password

MAIL_DOMAIN=yourdomain.com
MAIL_FROM=mail@yourdomain.com

API_KEY=replace-with-a-long-random-secret
INBOUND_WEBHOOK_SECRET=replace-with-a-different-long-random-secret
